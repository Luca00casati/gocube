#!/usr/bin/env python
# GoCube voxel engine: a GDExtension for stock Godot 4.5+, built like Godot
# and godot-cpp are (SCons). From the project root:
#   scons -C engine                                  # Linux
#   scons -C engine platform=windows use_mingw=yes   # Windows, cross-compiled with MinGW
# Add target=template_release for the release library and -j for parallel jobs.
# Output: bin/libgocube.<platform>.<target>.x86_64.<so|dll>, loaded via
# bin/gocube.gdextension; objects go to engine/build/.

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
if env.get("is_msvc", False):
    env.Append(CCFLAGS=["/W3"])
else:
    env.Append(CCFLAGS=["-Wall"])

# One object folder per platform/target, so Linux and Windows builds sit side by side.
build_dir = "build/" + env["suffix"].lstrip(".")
VariantDir(build_dir, "src", duplicate=False)
sources = Glob(build_dir + "/*.cpp")

library = env.SharedLibrary(
    "#../bin/libgocube{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
env.NoCache(library)
Default(library)
